{% assign profile = site.portfolio %}
{% if page.profile %}
  {% assign profile = page.profile %}
{% endif %}
{% capture display_name -%}
  {{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %}{% if site.last_name %} {{ site.last_name }}{% endif %}
{%- endcapture %}
<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ site.title | default: site.first_name }}
      {% if page.title and page.title != 'about' %} | {{ page.title }}{% endif %}
    </title>
    <meta name="description" content="{{ site.description | strip_html | strip_newlines | truncate: 160 }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <script>
      (() => {
        const themeStorageKey = 'anamika-theme';
        const accentStorageKey = 'anamika-accent';
        const accents = ['violet', 'teal', 'sky', 'rose', 'emerald'];
        let theme = 'dark';
        let accent = 'violet';

        try {
          const savedTheme = window.localStorage.getItem(themeStorageKey);
          const savedAccent = window.localStorage.getItem(accentStorageKey);
          if (savedTheme === 'light' || savedTheme === 'dark') theme = savedTheme;
          if (accents.includes(savedAccent)) accent = savedAccent;
        } catch (error) {
          theme = 'dark';
          accent = 'violet';
        }

        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeSetting = theme;
        document.documentElement.dataset.accent = accent;
      })();
    </script>
    <link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | relative_url }}">
    <link
      defer
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.2.0/css/all.min.css"
      integrity="sha256-MVopmdyC2tYTiJ8wlktf0uh0v4NgT+vNdyVFepi7Q0c="
      crossorigin="anonymous"
    >
    <link
      defer
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/academicons@1.9.5/css/academicons.min.css"
      integrity="sha256-SzrCOBJbGVFMahewkgjwnApaV2+av1DwMAA+/QGLyZw="
      crossorigin="anonymous"
    >
    <link
      defer
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/scholar-icons@1.0.3/css/scholar-icons.css"
      integrity="sha256-VY3hHVj/hNX3fYG6wtbA6TcKJQl7+FthzGSyIB64klY="
      crossorigin="anonymous"
    >
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">
  </head>
  <body class="anamika-portfolio-body">
    <canvas class="portfolio-particles" id="portfolio-particles" aria-hidden="true"></canvas>

    <div class="portfolio-shell">
      <aside class="portfolio-sidebar" aria-label="Profile">
        <a class="portfolio-photo-link" href="{{ profile.profile_url }}" target="_blank" rel="noopener">
          <img
            class="portfolio-photo"
            src="{{ '/assets/img/' | append: profile.image | relative_url }}"
            alt="{{ display_name | strip | default: 'Profile' }} portrait"
            width="220"
            height="220"
          >
        </a>

        <div class="portfolio-identity">
          <h1>{{ display_name | strip | default: site.title }}</h1>
          <p class="portfolio-role">{{ profile.title }}</p>
          <p class="portfolio-affiliation">{{ profile.affiliation }}</p>
          <p class="portfolio-blurb">{{ profile.blurb }}</p>
        </div>

        {% if profile.details %}
          <div class="portfolio-details">
            {% for detail in profile.details %}
              <p>{{ detail }}</p>
            {% endfor %}
          </div>
        {% endif %}

        <div class="portfolio-socials" aria-label="Profile links">
          {% if site.data.socials.email %}
            <a href="mailto:{{ site.data.socials.email }}" aria-label="Email">
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            </a>
          {% endif %}
          {% if site.data.socials.linkedin %}
            <a href="{{ site.data.socials.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
            </a>
          {% endif %}
          {% if site.data.socials.scholar_userid %}
            <a
              href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
              target="_blank"
              rel="noopener"
              aria-label="Google Scholar"
            >
              <i class="ai ai-google-scholar" aria-hidden="true"></i>
            </a>
          {% endif %}
          <a href="{{ profile.profile_url }}" target="_blank" rel="noopener" aria-label="LBNL profile">LBNL</a>
          <button class="portfolio-theme-toggle js-portfolio-theme-toggle" type="button" aria-label="Switch to light mode">
            <span class="portfolio-theme-track" aria-hidden="true">
              <i class="fa-solid fa-moon"></i>
              <i class="fa-solid fa-sun"></i>
              <span class="portfolio-theme-thumb"></span>
            </span>
          </button>
          <button class="portfolio-accent-toggle js-portfolio-accent-toggle" type="button" aria-label="Change accent color">
            <i class="fa-solid fa-palette" aria-hidden="true"></i>
            <span class="portfolio-accent-swatch" aria-hidden="true"></span>
          </button>
        </div>

        <p class="portfolio-copyright">
          &copy; {{ 'now' | date: '%Y' }}
          {{ display_name | strip | default: site.title }}
        </p>
      </aside>

      <main class="portfolio-main">
        <nav class="portfolio-nav" aria-label="Primary">
          <a class="{% if page.url == '/' %}active{% endif %}" href="{{ '/' | relative_url }}">About</a>
          <a class="{% if page.url contains '/research/' %}active{% endif %}" href="{{ '/research/' | relative_url }}">Research</a>
          <a class="{% if page.url contains '/publications/' %}active{% endif %}" href="{{ '/publications/' | relative_url }}">Publications</a>
          <a class="{% if page.url contains '/projects/' %}active{% endif %}" href="{{ '/projects/' | relative_url }}">Projects</a>
          <a class="{% if page.url contains '/contact/' %}active{% endif %}" href="{{ '/contact/' | relative_url }}">Contact</a>
          <button class="portfolio-theme-toggle js-portfolio-theme-toggle" type="button" aria-label="Switch to light mode">
            <span class="portfolio-theme-track" aria-hidden="true">
              <i class="fa-solid fa-moon"></i>
              <i class="fa-solid fa-sun"></i>
              <span class="portfolio-theme-thumb"></span>
            </span>
          </button>
          <button class="portfolio-accent-toggle js-portfolio-accent-toggle" type="button" aria-label="Change accent color">
            <i class="fa-solid fa-palette" aria-hidden="true"></i>
            <span class="portfolio-accent-swatch" aria-hidden="true"></span>
          </button>
        </nav>

        {{ content }}
      </main>
    </div>

    <script>
      (() => {
        const canvas = document.getElementById('portfolio-particles');
        const context = canvas.getContext('2d');
        const points = [];
        const count = window.matchMedia('(max-width: 720px)').matches ? 36 : 76;

        function resize() {
          const ratio = window.devicePixelRatio || 1;
          canvas.width = Math.floor(window.innerWidth * ratio);
          canvas.height = Math.floor(window.innerHeight * ratio);
          canvas.style.width = `${window.innerWidth}px`;
          canvas.style.height = `${window.innerHeight}px`;
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
        }

        function seed() {
          points.length = 0;
          for (let index = 0; index < count; index += 1) {
            points.push({
              x: Math.random() * window.innerWidth,
              y: Math.random() * window.innerHeight,
              vx: (Math.random() - 0.5) * 0.18,
              vy: (Math.random() - 0.5) * 0.18,
            });
          }
        }

        function draw() {
          context.clearRect(0, 0, window.innerWidth, window.innerHeight);
          const styles = window.getComputedStyle(document.documentElement);
          const particleColor = styles.getPropertyValue('--portfolio-particle-color').trim();
          const particleLineColor = styles.getPropertyValue('--portfolio-particle-line-color').trim();
          const particleDistance = Number.parseFloat(styles.getPropertyValue('--portfolio-particle-distance')) || 140;

          context.fillStyle = particleColor;
          context.strokeStyle = particleLineColor;
          context.lineWidth = 1;

          for (const point of points) {
            point.x += point.vx;
            point.y += point.vy;

            if (point.x < 0 || point.x > window.innerWidth) point.vx *= -1;
            if (point.y < 0 || point.y > window.innerHeight) point.vy *= -1;

            context.beginPath();
            context.arc(point.x, point.y, 2, 0, Math.PI * 2);
            context.fill();
          }

          for (let i = 0; i < points.length; i += 1) {
            for (let j = i + 1; j < points.length; j += 1) {
              const dx = points[i].x - points[j].x;
              const dy = points[i].y - points[j].y;
              const distance = Math.sqrt(dx * dx + dy * dy);

              if (distance < particleDistance) {
                context.globalAlpha = 1 - distance / particleDistance;
                context.beginPath();
                context.moveTo(points[i].x, points[i].y);
                context.lineTo(points[j].x, points[j].y);
                context.stroke();
              }
            }
          }

          context.globalAlpha = 1;
          window.requestAnimationFrame(draw);
        }

        window.addEventListener('resize', () => {
          resize();
          seed();
        });

        resize();
        seed();
        draw();
      })();

      (() => {
        const storageKey = 'anamika-theme';
        const toggles = document.querySelectorAll('.js-portfolio-theme-toggle');
        if (!toggles.length) return;

        function setTheme(theme) {
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.themeSetting = theme;
          for (const toggle of toggles) {
            toggle.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
          }

          try {
            window.localStorage.setItem(storageKey, theme);
          } catch (error) {
            // Ignore private browsing storage failures.
          }
        }

        for (const toggle of toggles) {
          toggle.addEventListener('click', () => {
            const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
            setTheme(currentTheme === 'dark' ? 'light' : 'dark');
          });
        }

        setTheme(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
      })();

      (() => {
        const storageKey = 'anamika-accent';
        const accents = ['violet', 'teal', 'sky', 'rose', 'emerald'];
        const toggles = document.querySelectorAll('.js-portfolio-accent-toggle');
        if (!toggles.length) return;

        function labelFor(accent) {
          return accent.charAt(0).toUpperCase() + accent.slice(1);
        }

        function setAccent(accent) {
          const nextAccent = accents.includes(accent) ? accent : 'violet';
          document.documentElement.dataset.accent = nextAccent;
          for (const toggle of toggles) {
            toggle.setAttribute('aria-label', `Change accent color. Current: ${labelFor(nextAccent)}`);
          }

          try {
            window.localStorage.setItem(storageKey, nextAccent);
          } catch (error) {
            // Ignore private browsing storage failures.
          }
        }

        for (const toggle of toggles) {
          toggle.addEventListener('click', () => {
            const currentAccent = document.documentElement.dataset.accent || 'violet';
            const currentIndex = accents.indexOf(currentAccent);
            setAccent(accents[(currentIndex + 1) % accents.length]);
          });
        }

        setAccent(document.documentElement.dataset.accent || 'violet');
      })();
    </script>
  </body>
</html>
