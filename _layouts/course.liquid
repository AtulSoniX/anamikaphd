---
layout: portfolio
---
<article class="portfolio-section portfolio-section-first" aria-labelledby="course-title">
  <header class="portfolio-page-header">
    <p class="portfolio-kicker">
      {{ page.year -}}
      {%- if page.term %} · {{ page.term }}{% endif %}
    </p>
    <h1 id="course-title">{{ page.title }}</h1>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
  </header>

  <div class="portfolio-panel portfolio-rich-text">
    {% if page.instructor or page.location or page.time %}
      <dl class="portfolio-meta-list">
        {% if page.instructor %}
          <div>
            <dt>Instructor</dt>
            <dd>{{ page.instructor }}</dd>
          </div>
        {% endif %}
        {% if page.location %}
          <div>
            <dt>Location</dt>
            <dd>{{ page.location }}</dd>
          </div>
        {% endif %}
        {% if page.time %}
          <div>
            <dt>Time</dt>
            <dd>{{ page.time }}</dd>
          </div>
        {% endif %}
      </dl>
    {% endif %}

    {{ content }}

    {% if page.schedule %}
      <h2>Schedule</h2>
      <div class="portfolio-table-wrap">
        <table>
          <thead>
            <tr>
              <th>Session</th>
              <th>Topic</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            {% for item in page.schedule %}
              <tr>
                <td>{{ item.date | default: item.week }}</td>
                <td>{{ item.topic | default: item.title }}</td>
                <td>{{ item.description }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</article>
