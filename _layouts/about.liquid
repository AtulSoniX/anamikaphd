---
layout: portfolio
---
<section class="portfolio-section portfolio-section-first" id="about" aria-labelledby="biography-title">
  <div class="portfolio-heading">
    <span class="portfolio-heading-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-4 0-7 2.2-7 5v1h14v-1c0-2.8-3-5-7-5Z"></path>
      </svg>
    </span>
    <h2 id="biography-title">Biography</h2>
  </div>

  <div class="portfolio-panel portfolio-bio">
    {{ content }}
  </div>
</section>

<section class="portfolio-section" id="research" aria-labelledby="focus-title">
  <div class="portfolio-heading">
    <span class="portfolio-heading-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path d="M4 17h4v3H4Zm6-6h4v9h-4Zm6-7h4v16h-4Z"></path>
      </svg>
    </span>
    <h2 id="focus-title">Current Focus Areas</h2>
  </div>

  <div class="portfolio-focus-grid">
    {% for area in page.focus_areas %}
      <article class="portfolio-focus-card">
        <h3>{{ area.title }}</h3>
        <p>{{ area.description }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% if page.professional_affiliations %}
  <section class="portfolio-section" id="professional-affiliations" aria-labelledby="affiliations-title">
    <div class="portfolio-heading">
      <span class="portfolio-heading-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="img">
          <path d="M10 4h4v3h5v13H5V7h5Zm2 3h0Zm-5 5h10V9H7Zm0 6h10v-4H7Z"></path>
        </svg>
      </span>
      <h2 id="affiliations-title">Professional Affiliations</h2>
    </div>

    <div class="portfolio-affiliations">
      {% for affiliation in page.professional_affiliations %}
        <article class="portfolio-affiliation-card">
          <div class="portfolio-affiliation-head">
            <h3>{{ affiliation.title }}</h3>
            <span>{{ affiliation.dates }}</span>
          </div>
          {% if affiliation.mentors %}
            <p>{{ affiliation.mentors }}</p>
          {% endif %}
          <p>{{ affiliation.organization }}</p>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% if page.education %}
  <section class="portfolio-section" id="education" aria-labelledby="education-title">
    <div class="portfolio-heading">
      <span class="portfolio-heading-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="img">
          <path d="M12 3 2 8l10 5 10-5Zm-6 8v4.5c1.8 1.8 3.8 2.7 6 2.7s4.2-.9 6-2.7V11l-6 3Z"></path>
        </svg>
      </span>
      <h2 id="education-title">Education</h2>
    </div>

    <div class="portfolio-affiliations portfolio-education-list">
      {% for item in page.education %}
        <article class="portfolio-affiliation-card portfolio-education-card">
          <div class="portfolio-affiliation-head">
            <h3>{{ item.degree }} | {{ item.field }}</h3>
          </div>
          <p class="portfolio-education-institution">{{ item.institution }}</p>
          {% if item.supervisors %}
            <p><strong>Supervisors:</strong> {{ item.supervisors }}</p>
          {% endif %}
          {% if item.project %}
            <p><strong>Project:</strong> {{ item.project }}</p>
          {% endif %}
          {% if item.thesis %}
            <p><strong>Thesis:</strong> {{ item.thesis }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

<section class="portfolio-section" id="contact" aria-labelledby="contact-title">
  <div class="portfolio-heading">
    <span class="portfolio-heading-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path d="M4 5h16v14H4Zm8 8 7-5.2V7l-7 5.1L5 7v.8Z"></path>
      </svg>
    </span>
    <h2 id="contact-title">Get in Touch</h2>
  </div>

  <div class="portfolio-panel portfolio-contact">
    <p>I am open to research collaborations, academic conversations, and opportunities around energy systems optimization.</p>
    <div class="portfolio-contact-actions">
      {% if site.data.socials.email %}
        <a href="mailto:{{ site.data.socials.email }}">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          <span>Email</span>
        </a>
      {% endif %}
      {% if site.data.socials.linkedin %}
        <a href="{{ site.data.socials.linkedin }}" target="_blank" rel="noopener">
          <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
          <span>LinkedIn</span>
        </a>
      {% endif %}
      {% if site.data.socials.scholar_userid %}
        <a
          href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
          target="_blank"
          rel="noopener"
        >
          <i class="ai ai-google-scholar" aria-hidden="true"></i>
          <span>Google Scholar</span>
        </a>
      {% endif %}
      <a href="{{ page.profile.profile_url }}" target="_blank" rel="noopener">LBNL Profile</a>
      <a href="{{ '/publications/' | relative_url }}">Publications</a>
    </div>
  </div>
</section>
