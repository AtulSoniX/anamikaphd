---
layout: portfolio
---
<section class="portfolio-section portfolio-section-first" aria-labelledby="page-title">
  <header class="portfolio-page-header">
    <p class="portfolio-kicker">Anamika Tiwari</p>
    <h1 id="page-title">{{ page.title }}</h1>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
  </header>

  <div class="portfolio-profile-grid">
    {% for profile in page.profiles %}
      <article class="portfolio-panel portfolio-profile-card">
        <img src="{{ '/assets/img/' | append: profile.image | relative_url }}" alt="Profile image">
        <div>
          {% if profile.content %}
            {% capture profile_path %}_pages/{{ profile.content }}{% endcapture %}
            {% assign profile_page = site.pages | where: 'path', profile_path | first %}
            {{ profile_page.content | markdownify }}
          {% endif %}
          {{ profile.more_info }}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
