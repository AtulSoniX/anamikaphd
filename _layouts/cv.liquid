---
layout: portfolio
---
<section class="portfolio-section portfolio-section-first" aria-labelledby="page-title">
  <header class="portfolio-page-header">
    <p class="portfolio-kicker">Anamika Tiwari</p>
    <h1 id="page-title">{{ page.title }}</h1>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
  </header>

  <div class="portfolio-panel portfolio-rich-text">
    {% if page.cv_pdf %}
      <p>
        <a class="portfolio-button" href="{{ page.cv_pdf | relative_url }}">Download PDF</a>
      </p>
    {% endif %}
    {% al_folio_cv_render %}
  </div>
</section>
