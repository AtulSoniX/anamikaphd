---
layout: portfolio
---
<article class="portfolio-section portfolio-section-first" aria-labelledby="post-title">
  <header class="portfolio-page-header">
    <p class="portfolio-kicker">{{ page.date | date: '%B %-d, %Y' }}</p>
    <h1 id="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
  </header>

  <div class="portfolio-panel portfolio-rich-text">
    {{ content }}
  </div>
</article>
