---
layout: portfolio
---
<section class="portfolio-section portfolio-section-first" aria-labelledby="page-title">
  <header class="portfolio-page-header">
    <p class="portfolio-kicker">Anamika Tiwari</p>
    <h1 id="page-title">{{ page.title }}</h1>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
  </header>

  <div class="portfolio-panel portfolio-rich-text">
    {{ content }}
  </div>

  {% assign books = site[page.collection] | sort: 'title' %}
  {% if books %}
    <div class="portfolio-focus-grid portfolio-book-grid">
      {% for book in books %}
        <article class="portfolio-focus-card">
          <h3>
            <a href="{{ book.url | relative_url }}">{{ book.title }}</a>
          </h3>
          {% if book.author %}
            <p>{{ book.author }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>
